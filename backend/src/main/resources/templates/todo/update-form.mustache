{{> layout/header}}

<style>
    .update-container {
        padding: 60px 0;
        min-height: calc(100vh - 70px);
        background-color: var(--bg);
    }

    .update-card {
        background: #111214;
        border: 0.5px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        padding: 40px;
        max-width: 560px;
        margin: 0 auto;
    }

    .card-eyebrow {
        font-size: 10px;
        letter-spacing: 3px;
        color: var(--danger);
        margin-bottom: 6px;
    }

    .card-title {
        font-size: 24px;
        font-weight: 700;
        color: #fff;
        letter-spacing: -0.5px;
        margin-bottom: 32px;
    }

    .form-group { margin-bottom: 22px; }

    .form-label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        color: #444;
        margin-bottom: 8px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .form-control {
        width: 100%;
        background: rgba(255,255,255,0.03);
        border: 0.5px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        padding: 14px 16px;
        color: #fff;
        font-size: 14px;
        transition: 0.2s;
        outline: none;
    }
    .form-control::placeholder { color: #333; }
    .form-control:focus {
        border-color: rgba(248,113,113,0.4);
        background: rgba(248,113,113,0.04);
    }
    .form-control::-webkit-calendar-picker-indicator { filter: invert(0.3); cursor: pointer; }

    .penalty-wrap { position: relative; }
    .penalty-symbol {
        position: absolute; left: 14px; top: 50%;
        transform: translateY(-50%);
        color: #444; font-size: 14px; pointer-events: none;
    }
    .penalty-wrap .form-control { padding-left: 30px; }

    .info-text {
        font-size: 11px;
        color: #333;
        margin-top: 6px;
    }

    .divider {
        border: none;
        border-top: 0.5px solid rgba(255,255,255,0.06);
        margin: 32px 0 24px;
    }

    .btn-group {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 10px;
    }

    .btn-cancel {
        background: transparent;
        border: 0.5px solid rgba(255,255,255,0.08);
        color: #555;
        padding: 14px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        transition: 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .btn-cancel:hover { background: rgba(255,255,255,0.04); color: #aaa; }

    .btn-submit {
        background: var(--danger);
        color: #fff;
        border: none;
        padding: 14px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s;
    }
    .btn-submit:hover { background: #f95e5e; transform: translateY(-2px); }
</style>
<link rel="stylesheet" href="/css/app-theme.css">

<div class="update-container">
    <div class="container">
        <div class="update-card">
            <p class="card-eyebrow">EDIT MISSION</p>
            <h1 class="card-title">미션 수정하기</h1>

            <form action="/groups/{{groupId}}/todos/{{todo.id}}/update" method="post">
                <input type="hidden" name="{{_csrf.parameterName}}" value="{{_csrf.token}}">
                <div class="form-group">
                    <label class="form-label">일정명</label>
                    <input type="text" name="work" class="form-control"
                           value="{{todo.work}}" placeholder="미션 내용을 입력하세요" required>
                </div>

                <div class="form-group">
                    <label class="form-label">마감 기한</label>
                    <input type="datetime-local" name="deadline" class="form-control"
                           value="{{todo.getDeadlineForInput}}" required>
                    <p class="info-text">현재 설정: {{todo.getFormatDeadline}}</p>
                </div>

                <div class="form-group">
                    <label class="form-label">미이행 벌금</label>
                    <div class="penalty-wrap">
                        <span class="penalty-symbol">₩</span>
                        <input type="number" name="amount" class="form-control"
                               value="{{#todo.fine}}{{amount}}{{/todo.fine}}{{^todo.fine}}0{{/todo.fine}}"
                               placeholder="0" min="0">
                    </div>
                    <p class="info-text">미션 실패 시 부과될 벌금을 입력해 주세요.</p>
                </div>

                <hr class="divider">

                <div class="btn-group">
                    <a href="/groups/{{groupId}}/todos" class="btn-cancel">취소</a>
                    <button type="submit" class="btn-submit">수정 완료</button>
                </div>
            </form>
        </div>
    </div>
</div>

{{> layout/footer}}
