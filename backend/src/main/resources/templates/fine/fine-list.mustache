{{> layout/header}}

<style>
    .fine-page-container {
        width: 100%;
        min-height: calc(100vh - 64px);
        background-color: var(--bg);
        padding: 48px 0 80px;
    }

    .fine-summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 12px;
        margin-bottom: 24px;
    }

    .summary-card {
        background: #111214;
        border: 0.5px solid rgba(255,255,255,0.08);
        border-radius: 14px;
        padding: 22px 24px;
    }
    .summary-card.danger { background: #1a1010; border-color: rgba(248,113,113,0.2); }
    .summary-card.success { background: #0d1a10; border-color: rgba(52,211,153,0.2); }
    .summary-card.group { background: #0d0f1a; border-color: rgba(77,163,255,0.2); }

    .summary-label { font-size: 9px; letter-spacing: 2px; color: #444; margin-bottom: 8px; display: block; text-transform: uppercase; }
    .summary-card.danger .summary-label { color: rgba(248,113,113,0.5); }
    .summary-card.success .summary-label { color: rgba(52,211,153,0.5); }
    .summary-card.group .summary-label { color: rgba(77,163,255,0.5); }

    .summary-value { font-size: 24px; font-weight: 800; letter-spacing: -1px; color: #fff; margin-bottom: 4px; }
    .summary-value.red { color: var(--danger); }
    .summary-value.green { color: #34d399; }
    .summary-value.blue { color: #4da3ff; }

    .summary-sub { font-size: 12px; color: #333; font-weight: 600; }
    .summary-sub.red { color: rgba(248,113,113,0.5); }
    .summary-sub.green { color: rgba(52,211,153,0.5); }
    .summary-sub.blue { color: rgba(77,163,255,0.5); }

    .action-bar { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }

    .btn-filter-pill {
        display: flex; align-items: center; gap: 8px;
        background: #1c1f23; border: 0.5px solid #2a2d33;
        padding: 9px 18px; border-radius: 50px;
        cursor: pointer; transition: all 0.2s ease; text-decoration: none;
    }
    .btn-filter-pill .dot { width: 6px; height: 6px; background: #444; border-radius: 50%; transition: 0.2s; }
    .btn-filter-pill span { color: #777; font-size: 13px; font-weight: 600; }
    .btn-filter-pill:hover { background: #22262d; border-color: #3a3d45; }
    .btn-filter-pill.filter-active { background: rgba(77,163,255,0.08); border-color: rgba(77,163,255,0.4); }
    .btn-filter-pill.filter-active .dot { background: #4da3ff; }
    .btn-filter-pill.filter-active span { color: #4da3ff; }

    .fine-main-card {
        background: #111214;
        border: 0.5px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        padding: 28px;
    }

    .fine-list-header {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 24px; padding-bottom: 16px;
        border-bottom: 0.5px solid rgba(255,255,255,0.06);
    }
    .fine-list-header h2 { font-size: 18px; font-weight: 600; }
    .fine-list-header span { font-size: 13px; color: #444; }

    .fine-table { width: 100%; border-collapse: collapse; }
    .fine-table th {
        text-align: left; padding: 10px 14px;
        color: #333; font-size: 10px;
        text-transform: uppercase; letter-spacing: 1px; font-weight: 700;
    }
    .fine-table td {
        padding: 16px 14px;
        border-bottom: 0.5px solid rgba(255,255,255,0.04);
        vertical-align: middle; font-size: 13px;
    }
    .fine-table tr:last-child td { border-bottom: none; }
    .fine-table tr:hover td { background: rgba(255,255,255,0.01); }

    .status-badge {
        padding: 4px 10px; border-radius: 6px;
        font-size: 10px; font-weight: 700;
        display: inline-block; text-transform: uppercase; letter-spacing: 1px;
    }
    .status-UNPAID { background: rgba(248,113,113,0.1); color: var(--danger); border: 0.5px solid rgba(248,113,113,0.2); }
    .status-PAID   { background: rgba(52,211,153,0.1); color: #34d399; border: 0.5px solid rgba(52,211,153,0.2); }

    .user-badge { font-weight: 600; color: var(--danger); font-size: 13px; }
    .fine-amount { font-weight: 700; color: var(--danger); }
    .memo-text { font-size: 11px; color: #555; margin-top: 4px; }

    .btn-pay {
        background: rgba(248,113,113,0.1); color: var(--danger);
        border: 0.5px solid rgba(248,113,113,0.25);
        padding: 6px 14px; border-radius: 8px;
        font-size: 12px; font-weight: 700; cursor: pointer; transition: 0.2s;
    }
    .btn-pay:hover { background: var(--danger); color: #fff; }

    .empty-cell { text-align: center; padding: 80px 0 !important; color: #2a2a2a; font-size: 14px; }

    .modal-overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(0,0,0,0.75); z-index: 999;
        align-items: center; justify-content: center;
    }
    .modal-overlay.active { display: flex; }
    .modal-box {
        background: #111214;
        border: 0.5px solid rgba(255,255,255,0.08);
        border-radius: 20px; padding: 36px;
        width: 90%; max-width: 420px; position: relative;
    }
    .modal-close {
        position: absolute; top: 16px; right: 16px;
        background: transparent; border: none; color: #444;
        font-size: 18px; cursor: pointer; transition: 0.2s;
    }
    .modal-close:hover { color: #aaa; }
    .modal-eyebrow { font-size: 10px; letter-spacing: 3px; color: var(--danger); margin-bottom: 6px; }
    .modal-title { font-size: 20px; font-weight: 700; margin-bottom: 8px; }
    .modal-sub { font-size: 13px; color: #555; margin-bottom: 24px; }
    .modal-label { font-size: 11px; color: #444; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 8px; }

    .modal-input {
        width: 100%;
        background: rgba(255,255,255,0.03);
        border: 0.5px solid rgba(255,255,255,0.08);
        border-radius: 10px; padding: 13px 16px;
        color: #fff; font-size: 14px; outline: none; transition: 0.2s;
        margin-bottom: 16px;
    }
    .modal-input::placeholder { color: #333; }
    .modal-input:focus { border-color: rgba(248,113,113,0.4); background: rgba(248,113,113,0.04); }

    .btn-modal-submit {
        width: 100%; background: var(--danger); color: #fff;
        border: none; padding: 14px; border-radius: 10px;
        font-size: 14px; font-weight: 700; cursor: pointer; transition: 0.2s;
    }
    .btn-modal-submit:hover { background: #f95e5e; transform: translateY(-2px); }
</style>
<link rel="stylesheet" href="/css/app-theme.css">

<main class="fine-page-container">
    <div class="container">

        <div style="margin-bottom: 32px;">
            <div style="font-size: 10px; letter-spacing: 3px; color: var(--danger); margin-bottom: 6px;">FINANCIAL REPORT</div>
            <h1 style="font-size: 26px; font-weight: 700; letter-spacing: -0.5px;">벌금 현황</h1>
        </div>

        <!-- 요약 카드 -->
        <div class="fine-summary-grid">
            <div class="summary-card danger">
                <span class="summary-label">UNPAID</span>
                <div class="summary-value red">{{fineInfo.unpaidCount}}<span style="font-size: 14px; margin-left: 4px;">건</span></div>
                <div class="summary-sub red">₩{{fineInfo.unpaidAmount}}</div>
            </div>
            <div class="summary-card success">
                <span class="summary-label">PAID</span>
                <div class="summary-value green">{{fineInfo.paidCount}}<span style="font-size: 14px; margin-left: 4px;">건</span></div>
                <div class="summary-sub green">₩{{fineInfo.paidAmount}}</div>
            </div>
            <div class="summary-card danger">
                <span class="summary-label">총 미납 벌금</span>
                <div class="summary-value red">₩{{fineInfo.totalFinesAmount}}</div>
                <div class="summary-sub red">미납 합산</div>
            </div>
            <div class="summary-card group">
                <span class="summary-label">그룹 포인트</span>
                <div class="summary-value blue">{{group.groupPoint}}<span style="font-size: 14px; margin-left: 4px;">P</span></div>
                <div class="summary-sub blue">납부 완료 적립 포인트</div>
            </div>
        </div>

        <!-- 필터 액션 바 -->
        <div class="action-bar">
            <!-- 내 벌금 / 전체 토글 -->
            <button onclick="toggleMyFilter()"
                    class="btn-filter-pill {{#isFiltered}}filter-active{{/isFiltered}}">
                <div class="dot"></div>
                <span>내 벌금 보기</span>
            </button>

            <!-- 납부 상태 필터 -->
            <button onclick="toggleStatus()"
                    class="btn-filter-pill {{#currentStatus}}filter-active{{/currentStatus}}">
                <div class="dot"></div>
                <span>
                    {{#isStatusUnpaid}}미납{{/isStatusUnpaid}}
                    {{#isStatusPaid}}납부 완료{{/isStatusPaid}}
                    {{#isStatusNone}}납부 상태{{/isStatusNone}}
                </span>
            </button>
        </div>

        <div class="fine-main-card">
            <div class="fine-list-header">
                <h2>전체 내역</h2>
                <span>총 {{fineInfo.expiredFines.size}}건</span>
            </div>

            <table class="fine-table">
                <thead>
                <tr>
                    <th>수행자</th>
                    <th>미션</th>
                    <th>벌금</th>
                    <th>상태</th>
                    <th style="text-align:right;">관리</th>
                </tr>
                </thead>
                <tbody>
                {{#fineInfo.expiredFines}}
                    <tr>
                        <td>
                            {{#todo}}
                                <span class="user-badge">@ {{todo.groupMember.user.nickname}}</span>
                            {{/todo}}
                            {{^todo}}
                                <span style="font-size: 12px; color: #444; font-style: italic;">탈퇴한 멤버</span>
                            {{/todo}}
                        </td>
                        <td>
                            {{#todo}}
                                <div style="color: #ccc;">{{todo.work}}</div>
                            {{/todo}}
                            {{^todo}}
                                <div style="font-size: 12px; color: #444; font-style: italic;">삭제된 미션</div>
                            {{/todo}}
                            {{#memo}}
                                <div class="memo-text">💬 {{memo}}</div>
                            {{/memo}}
                        </td>
                        <td><span class="fine-amount">₩{{amount}}</span></td>
                        <td><span class="status-badge status-{{status}}">{{status}}</span></td>
                        <td style="text-align:right;">
                            {{#isUnpaid}}
                                <button class="btn-pay"
                                        onclick="openPayModal({{fineId}}, '{{todo.work}}', {{amount}})">
                                    납부하기
                                </button>
                            {{/isUnpaid}}
                            {{#isPaid}}
                                <span style="font-size: 12px; color: #34d399; font-weight: 700;">✓ 납부 완료</span>
                            {{/isPaid}}
                        </td>
                    </tr>
                {{/fineInfo.expiredFines}}
                {{^fineInfo.expiredFines}}
                    <tr>
                        <td colspan="5" class="empty-cell">정산할 벌금 내역이 없습니다.</td>
                    </tr>
                {{/fineInfo.expiredFines}}
                </tbody>
            </table>
        </div>
    </div>
</main>

<!-- 납부 모달 -->
<div id="payModal" class="modal-overlay">
    <div class="modal-box">
        <button class="modal-close" onclick="closePayModal()">✕</button>
        <p class="modal-eyebrow">PAYMENT</p>
        <h3 class="modal-title">포인트 납부</h3>
        <p class="modal-sub" id="payModalSub"></p>

        <form id="payForm" method="post">
            <input type="hidden" name="{{_csrf.parameterName}}" value="{{_csrf.token}}">
            <input type="hidden" name="groupId" value="{{groupId}}">
            <div class="modal-label">납부 메모 (선택)</div>
            <input type="text" name="memo" class="modal-input"
                   placeholder="예: 포인트 납부 완료">
            <button type="submit" class="btn-modal-submit">포인트로 납부하기</button>
        </form>
    </div>
</div>

<script>
    function toggleMyFilter() {
        const params = new URLSearchParams(window.location.search);
        if (params.get('filter') === 'my') {
            params.delete('filter');
        } else {
            params.set('filter', 'my');
        }
        window.location.search = params.toString();
    }

    function toggleStatus() {
        const params = new URLSearchParams(window.location.search);
        const current = params.get('status');
        if (!current) {
            params.set('status', 'unpaid');
        } else if (current === 'unpaid') {
            params.set('status', 'paid');
        } else {
            params.delete('status');
        }
        window.location.search = params.toString();
    }

    function openPayModal(fineId, work, amount) {
        document.getElementById('payModalSub').textContent =
            `"${work}" 벌금 ₩${amount.toLocaleString()}을 포인트로 납부합니다.`;
        document.getElementById('payForm').action = `/fines/${fineId}/pay`;
        document.getElementById('payModal').classList.add('active');
    }

    function closePayModal() {
        document.getElementById('payModal').classList.remove('active');
    }

    document.getElementById('payModal').addEventListener('click', function(e) {
        if (e.target === this) closePayModal();
    });
</script>

{{> layout/footer}}
