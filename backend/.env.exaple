# google 소셜 로그인
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 비밀번호 재설정 메일 (Gmail은 앱 비밀번호 사용)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# SMS 발송 (SOLAPI, prod 프로필에서만 사용)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=

# 푸시 알림 (Firebase Cloud Messaging, prod 프로필에서만 사용)
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성으로 받은
# JSON 파일에서 project_id/client_email/private_key 값만 옮겨 적습니다.
# private_key는 줄바꿈을 "\n" 문자 그대로 남겨 한 줄로 붙여넣습니다.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
