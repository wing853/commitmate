{{> layout/header}}

<style>
    /* [Layout] 페이지 전체 배경 및 레이아웃 */
    .todo-page-container {
        width: 100%;
        min-height: calc(100vh - 70px);
        background-color: var(--bg);
        padding: 60px 0;
        position: relative;
        overflow: hidden;
    }

    /* [Header Area] 상단 타이틀 및 추가 버튼 섹션 */
    .mission-status-board {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 40px;
    }

    .mission-title-area h1 {
        font-size: 42px;
        font-weight: 850;
        letter-spacing: -2px;
        margin-bottom: 10px;
    }

    .mission-title-area h1 span {
        color: var(--accent);
    }

    /* 새 미션 추가 버튼 (Card Style) */
    .btn-add-mission-card {
        display: flex;
        align-items: center;
        gap: 15px;
        background: var(--glass);
        border: 1px solid var(--border);
        padding: 12px 24px;
        border-radius: 16px;
        text-decoration: none;
        transition: 0.3s;
    }

    .btn-add-mission-card:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: var(--accent);
        transform: translateY(-3px);
    }

    .plus-box {
        width: 32px;
        height: 32px;
        background: var(--accent);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: white;
    }

    .add-text-group { display: flex; flex-direction: column; }
    .add-text-main { color: #fff; font-weight: 700; font-size: 15px; }
    .add-text-sub { color: var(--text-muted); font-size: 12px; }

    /* [Main Card] 미션 리스트 카드 */
    .todo-main-card {
        background: #0a0a0a;
        border: 1px solid var(--border);
        border-radius: 28px;
        padding: 20px;
        box-shadow: 0 40px 80px rgba(0,0,0,0.5);
    }

    .todo-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 12px;
    }

    .todo-row {
        background: rgba(255, 255, 255, 0.02);
        transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .todo-row:hover {
        background: rgba(255, 255, 255, 0.05);
        transform: scale(1.01);
    }

    .todo-row td {
        padding: 24px 15px;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
    }

    .todo-row td:first-child { border-left: 1px solid var(--border); border-radius: 20px 0 0 20px; padding-left: 25px; }
    .todo-row td:last-child { border-right: 1px solid var(--border); border-radius: 0 20px 20px 0; padding-right: 25px; }

    /* [Elements] 내부 요소 디테일 */
    .check-wrapper {
        width: 28px;
        height: 28px;
        border: 2px solid #333;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.2s;
    }

    .completed .check-wrapper {
        background: var(--accent);
        border-color: var(--accent);
    }

    .user-badge {
        font-weight: 700;
        color: var(--accent);
        font-size: 15px;
        letter-spacing: -0.5px;
    }

    .todo-text {
        color: #efefef;
        font-size: 18px;
        font-weight: 500;
    }

    .todo-row.completed .todo-text {
        color: #444;
        text-decoration: line-through;
    }

    /* 날짜 디자인 */
    .date-label { font-size: 10px; color: var(--text-muted); font-weight: 800; text-transform: uppercase; }
    .todo-date-text { color: #888; font-size: 14px; font-weight: 500; }

    /* 벌금 뱃지 디자인 */
    .penalty-badge {
        display: inline-flex;
        flex-direction: column;
        align-items: flex-end;
    }

    .fine-label { font-size: 9px; font-weight: 900; margin-bottom: 4px; }
    .penalty-badge:not(.free) .fine-label { color: var(--danger); }
    .penalty-badge.free .fine-label { color: #444; }

    .fine-val { color: var(--danger); font-size: 18px; font-weight: 800; }
    .free-val { color: #333; font-size: 18px; font-weight: 800; }

    /* 삭제 버튼 */
    .btn-todo-delete {
        background: transparent;
        border: 1px solid #222;
        color: #444;
        padding: 8px 16px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
    }

    .btn-todo-delete:hover {
        border-color: var(--danger);
        color: var(--danger);
        background: rgba(255, 77, 77, 0.05);
    }
</style>

<div class="spotlight"></div>

<main class="todo-page-container">
    <div class="container">

        <!-- 상단 헤더 -->
        <div class="mission-status-board">
            <div class="mission-title-area">
                <h1>📋 Group <span>Mission</span></h1>
                <p>팀의 목표를 관리하고 달성률을 높이세요.</p>
            </div>

            {{#todoList.0.groupMember.group.id}}
                <a href="/groups/{{todoList.0.groupMember.group.id}}/todo-form" class="btn-add-mission-card">
                    <div class="plus-box">+</div>
                    <div class="add-text-group">
                        <span class="add-text-main">새 미션 추가</span>
                        <span class="add-text-sub">목표 설계하기</span>
                    </div>
                </a>
            {{/todoList.0.groupMember.group.id}}
        </div>

        <!-- 메인 리스트 카드 -->
        <div class="todo-main-card">
            <table class="todo-table">
                <tbody>
                {{#todoList}}
                    <tr class="todo-row {{#isDone}}completed{{/isDone}}">
                        <!-- 체크박스 -->
                        <td style="width: 70px;">
                            <div class="check-wrapper" onclick="toggleTodo({{id}}, {{groupMember.group.id}})">
                                {{#isDone}}
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                {{/isDone}}
                            </div>
                        </td>

                        <!-- 담당자 -->
                        <td style="width: 140px;">
                            <span class="user-badge">@ {{groupMember.user.nickname}}</span>
                        </td>

                        <!-- 미션 내용 -->
                        <td>
                            <span class="todo-text">{{work}}</span>
                        </td>

                        <!-- 할당 날짜 -->
                        <td style="width: 180px;">
                            <div class="todo-date-wrapper">
                                <p class="date-label">Assigned Date</p>
                                <span class="todo-date-text">{{formatCreatedAt}}</span>
                            </div>
                        </td>

                        <td style="width: 180px;">
                            <div class="todo-date-wrapper">
                                <p class="date-label">Deadline</p>
                                <span class="todo-date-text">{{formatDeadline}}</span>
                            </div>
                        </td>

                        <!-- 벌금 상태 -->
                        <td style="width: 180px; text-align: right;">
                            {{#fine}}
                                <div class="penalty-badge">
                                    <span class="fine-label">PAYMENT DUE</span>
                                    <span class="fine-val">₩{{amount}}</span>
                                </div>
                            {{/fine}}
                            {{^fine}}
                                <div class="penalty-badge free">
                                    <span class="fine-label">NO PENALTY</span>
                                    <span class="free-val">FREE</span>
                                </div>
                            {{/fine}}
                        </td>

                        <!-- 삭제 관리 -->
                        <td style="width: 100px; text-align: right;">
                            <form action="/todo/{{id}}/delete" method="post" onsubmit="return confirm('미션을 삭제할까요?');">
                                <input type="hidden" name="groupId" value="{{groupMember.group.id}}">
                                <button type="submit" class="btn-todo-delete">삭제</button>
                            </form>
                        </td>
                    </tr>
                {{/todoList}}

                {{^todoList}}
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 100px 0; color: #444;">
                            <p style="font-size: 20px; font-weight: 600;">등록된 미션이 없습니다.</p>
                        </td>
                    </tr>
                {{/todoList}}
                </tbody>
            </table>
        </div>
    </div>
</main>

<script>
    function toggleTodo(todoId, groupId) {
        // 부드러운 사용자 경험을 위해 즉시 반영되는 것처럼 보이게 할 수도 있지만,
        // 현재는 서버로 이동하여 상태를 변경합니다.
        location.href = `/todo/${todoId}/toggle?groupId=${groupId}`;
    }
</script>

{{> layout/footer}}