{{> layout/header}}

<style>
    :root {
        --card-bg: rgba(255, 255, 255, 0.03);
        --card-hover: rgba(255, 255, 255, 0.06);
        --penalty-red: #ff4d4d;
        --success-green: #00ffa3;
    }

    .todo-page-container {
        padding: 80px 0;
        min-height: 80vh;
    }

    .mission-status-board {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 50px;
    }

    .mission-title-area h1 {
        font-size: 32px;
        font-weight: 850;
        letter-spacing: -1.5px;
        margin-bottom: 12px;
    }

    .btn-add-mission-card {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 28px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px dashed rgba(255, 255, 255, 0.3);
        border-radius: 20px;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .btn-add-mission-card:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: #fff;
        transform: translateY(-3px);
    }

    .plus-box {
        width: 36px; height: 36px; background: #fff; color: #000;
        border-radius: 10px; display: flex; align-items: center;
        justify-content: center; font-size: 22px; font-weight: bold;
    }

    .todo-main-card {
        background: #0a0a0a;
        border: 1px solid var(--border);
        border-radius: 28px;
        padding: 32px;
    }

    .todo-table { width: 100%; border-collapse: separate; border-spacing: 0 12px; }
    .todo-row { background: var(--card-bg); transition: all 0.3s; }
    .todo-row:hover { background: var(--card-hover); transform: translateY(-2px); }

    .todo-row td {
        padding: 24px;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
    }

    .todo-row td:first-child { border-left: 1px solid var(--border); border-radius: 18px 0 0 18px; }
    .todo-row td:last-child { border-right: 1px solid var(--border); border-radius: 0 18px 18px 0; }

    .check-wrapper {
        width: 30px; height: 30px; border: 2px solid var(--border);
        border-radius: 10px; display: flex; align-items: center;
        justify-content: center; cursor: pointer;
    }

    .todo-row.completed .check-wrapper { background: var(--accent); border-color: var(--accent); }
    .todo-text { font-size: 18px; font-weight: 600; color: #efefef; }
    .todo-row.completed .todo-text { color: #444; text-decoration: line-through; }

    /* [개선] 날짜 디자인 - 데이터 가독성 중심 */
    .todo-date-wrapper {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .date-label {
        font-size: 10px;
        font-weight: 800;
        color: #444;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .todo-date-content {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #aaa; /* 조금 더 밝게 조정 */
    }

    .todo-date-text {
        font-size: 14px;
        font-weight: 700;
        font-family: 'JetBrains Mono', monospace; /* 날짜는 고정폭 서체가 깔끔함 */
    }

    /* [개선] 패널티 요금 디자인 - 시각적 강조 */
    .penalty-badge {
        display: inline-flex;
        flex-direction: column;
        align-items: flex-end;
        padding: 8px 16px;
        background: rgba(255, 77, 77, 0.08); /* 은은한 레드 배경 */
        border: 1px solid rgba(255, 77, 77, 0.2);
        border-radius: 12px;
        min-width: 100px;
    }

    .penalty-badge.free {
        background: rgba(0, 255, 163, 0.05);
        border-color: rgba(0, 255, 163, 0.1);
    }

    .fine-label {
        font-size: 9px;
        font-weight: 900;
        margin-bottom: 2px;
        letter-spacing: 0.5px;
    }

    .fine-val {
        font-size: 17px;
        font-weight: 800;
        color: var(--penalty-red);
    }

    .free-val {
        font-size: 15px;
        font-weight: 700;
        color: var(--success-green);
        opacity: 0.8;
    }

    .btn-todo-delete {
        background: transparent; border: none; color: #444;
        font-size: 13px; font-weight: 600; cursor: pointer;
    }
    .btn-todo-delete:hover { color: var(--penalty-red); }
</style>

<main class="todo-page-container">
    <div class="container">

        <div class="mission-status-board">
            <div class="mission-title-area">
                <h1>📋 Group <span>Mission</span></h1>
                <p style="color: var(--text-muted); font-size: 17px;">팀의 목표를 관리하고 달성률을 높이세요.</p>
            </div>

            <a href="/groups/{{id}}/todo-form" class="btn-add-mission-card">
                <div class="plus-box">+</div>
                <div class="add-text-group">
                    <span class="add-text-main">새 미션 추가</span>
                    <span class="add-text-sub">목표 설계하기</span>
                </div>
            </a>
        </div>

        <div class="todo-main-card">
            <table class="todo-table">
                <tbody>
                {{#todoList}}
                    <tr class="todo-row {{#isDone}}completed{{/isDone}}">
                        <td style="width: 70px;">
                            <div class="check-wrapper" onclick="toggleTodo({{id}})">
                                {{#isDone}}
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                {{/isDone}}
                            </div>
                        </td>

                        <td style="width: 140px;">
                            <span class="user-badge">{{user.nickname}}</span>
                        </td>

                        <td>
                            <span class="todo-text">{{work}}</span>
                        </td>

                        <!-- [개선된 날짜 섹션] -->
                        <td style="width: 180px;">
                            <div class="todo-date-wrapper">
                                <span class="date-label">Assigned Date</span>
                                <div class="todo-date-content">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                    <span class="todo-date-text">{{formatCreatedAt}}</span>
                                </div>
                            </div>
                        </td>

                        <!-- [개선된 요금 섹션] -->
                        <td style="width: 180px; text-align: right;">
                            {{#fine}}
                                <div class="penalty-badge">
                                    <span class="fine-label" style="color: var(--penalty-red); opacity: 0.7;">PAYMENT DUE</span>
                                    <span class="fine-val">₩{{amount}}</span>
                                </div>
                            {{/fine}}
                            {{^fine}}
                                <div class="penalty-badge free">
                                    <span class="fine-label" style="color: var(--success-green); opacity: 0.5;">NO PENALTY</span>
                                    <span class="free-val">FREE</span>
                                </div>
                            {{/fine}}
                        </td>

                        <td style="width: 80px; text-align: right;">
                            <form action="/todo/{{id}}/delete" method="post" onsubmit="return confirm('미션을 삭제할까요?');">
                                <input type="hidden" name="groupId" value="{{group.id}}">
                                <button type="submit" class="btn-todo-delete">삭제</button>
                            </form>
                        </td>
                    </tr>
                {{/todoList}}
                </tbody>
            </table>
        </div>
    </div>
</main>

{{> layout/footer}}