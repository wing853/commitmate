{{> layout/header}}

<style>
    .todo-page-container {
        width: 100%;
        min-height: calc(100vh - 70px);
        background-color: var(--bg);
        padding: 60px 0;
        position: relative;
        overflow: hidden;
    }

    .mission-status-board {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 40px;
    }

    .mission-title-area h1 {
        font-size: 42px;
        font-weight: 850;
        letter-spacing: -2px;
        margin-bottom: 10px;
    }

    .mission-title-area h1 span {
        color: var(--accent);
    }

    .header-btn-group {
        display: flex;
        gap: 12px;
    }

    .btn-action-card {
        display: flex;
        align-items: center;
        gap: 15px;
        background: var(--glass);
        border: 1px solid var(--border);
        padding: 12px 24px;
        border-radius: 16px;
        text-decoration: none;
        transition: 0.3s;
    }

    .btn-action-card:hover {
        background: rgba(255, 255, 255, 0.08);
        transform: translateY(-3px);
    }

    .icon-box {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: white;
    }

    .bg-accent {
        background: var(--accent);
    }

    .bg-danger {
        background: var(--danger);
    }

    .todo-main-card {
        background: #0a0a0a;
        border: 1px solid var(--border);
        border-radius: 28px;
        padding: 20px;
        box-shadow: 0 40px 80px rgba(0,0,0,0.5);
    }

    .todo-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 12px;
    }

    .todo-row {
        background: rgba(255, 255, 255, 0.02);
        transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .todo-row:hover {
        transform: translateY(-2px);
    }

    .todo-row td {
        padding: 24px 15px;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
    }

    .todo-row td:first-child {
        border-left: 1px solid var(--border);
        border-radius: 20px 0 0 20px;
        padding-left: 25px;
    }

    .todo-row td:last-child {
        border-right: 1px solid var(--border);
        border-radius: 0 20px 20px 0;
        padding-right: 25px;
    }

    /* 체크박스 */
    .check-wrapper {
        width: 28px;
        height: 28px;
        border: 2px solid #333;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.2s;
    }

    /* 완료 */
    .completed .check-wrapper {
        background: var(--accent);
        border-color: var(--accent);
    }

    /* X 아이콘 */
    .expired-x {
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .user-badge {
        font-weight: 700;
        color: var(--accent);
        font-size: 15px;
    }

    .todo-text {
        color: #efefef;
        font-size: 18px;
        font-weight: 500;
    }

    .todo-row.completed .todo-text {
        color: #444;
        text-decoration: line-through;
    }

    .date-label {
        font-size: 10px;
        color: var(--text-muted);
        font-weight: 800;
        text-transform: uppercase;
    }

    .todo-date-text {
        color: #888;
        font-size: 14px;
        font-weight: 500;
    }

    .overdue-text {
        color: var(--danger) !important;
        font-weight: 700;
    }

    /* 상태 배지 */
    .penalty-badge {
        display: inline-flex;
        flex-direction: column;
        align-items: flex-end;
    }

    .fine-label {
        font-size: 9px;
        font-weight: 900;
        margin-bottom: 4px;
    }

    .penalty-badge:not(.free):not(.complete-badge) .fine-label {
        color: var(--danger);
    }

    .fine-val {
        color: var(--danger);
        font-size: 18px;
        font-weight: 800;
    }

    /* FREE 상태 */
    .penalty-badge.free .free-label {
        color: #00d68f;
    }

    .penalty-badge.free .free-text {
        color: #00d68f;
        font-size: 15px;
        font-weight: 800;
    }

    /* COMPLETE 상태 */
    .complete-badge .fine-label {
        color: #4da3ff;
    }

    .complete-text {
        color: #4da3ff;
        font-size: 15px;
        font-weight: 900;
    }

    /* 버튼 */
    .btn-todo-action {
        background: transparent;
        border: 1px solid #222;
        color: #666;
        padding: 8px 14px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-todo-edit:hover {
        border-color: var(--accent);
        color: var(--accent);
        background: rgba(99, 102, 241, 0.08);
    }

    .btn-todo-delete:hover {
        border-color: var(--danger);
        color: var(--danger);
        background: rgba(255, 77, 77, 0.05);
    }
</style>

<div class="spotlight"></div>

<main class="todo-page-container">
    <div class="container">

        <!-- 헤더 -->
        <div class="mission-status-board">

            <div class="mission-title-area">
                <h1>📋 Group <span>Mission</span></h1>
                <p>팀의 목표를 관리하고 달성률을 높이세요.</p>
            </div>

            <div class="header-btn-group">

                <!-- todo 존재 -->
                {{#todoList.0}}

                    <a href="/groups/{{groupMember.group.id}}/fines"
                       class="btn-action-card">

                        <div class="icon-box bg-danger">₩</div>

                        <div class="add-text-group">
                            <span style="color: #fff; font-weight: 700; font-size: 15px;">
                                벌금 현황
                            </span>
                        </div>

                    </a>

                    <a href="/groups/{{groupMember.group.id}}/todo-form"
                       class="btn-action-card">

                        <div class="icon-box bg-accent">+</div>

                        <div class="add-text-group">
                            <span style="color: #fff; font-weight: 700; font-size: 15px;">
                                새 미션 추가
                            </span>
                        </div>

                    </a>

                {{/todoList.0}}

                <!-- 새 방 -->
                {{^todoList.0}}

                    <a href="/groups/{{id}}/fines"
                       class="btn-action-card">

                        <div class="icon-box bg-danger">₩</div>

                        <div class="add-text-group">
                            <span style="color: #fff; font-weight: 700; font-size: 15px;">
                                벌금 현황
                            </span>
                        </div>

                    </a>

                    <a href="/groups/{{id}}/todo-form"
                       class="btn-action-card">

                        <div class="icon-box bg-accent">+</div>

                        <div class="add-text-group">
                            <span style="color: #fff; font-weight: 700; font-size: 15px;">
                                새 미션 추가
                            </span>
                        </div>

                    </a>

                {{/todoList.0}}

            </div>
        </div>

        <!-- 메인 -->
        <div class="todo-main-card">

            <table class="todo-table">
                <tbody>

                {{#todoList}}

                    <tr class="todo-row {{#isDone}}completed{{/isDone}} {{#isExpired}}overdue{{/isExpired}}">

                        <!-- 체크 -->
                        <td style="width: 70px;">

                            <!-- 완료 -->
                            {{#isDone}}

                                <div class="check-wrapper"
                                     onclick="toggleTodo({{id}}, {{groupMember.group.id}})">

                                    <svg width="14"
                                         height="14"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="white"
                                         stroke-width="4"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <polyline points="20 6 9 17 4 12"></polyline>

                                    </svg>

                                </div>

                            {{/isDone}}

                            <!-- 미완료 -->
                            {{^isDone}}

                                <!-- 기한 초과 -->
                                {{#isExpired}}

                                    <div class="expired-x">

                                        <svg width="22"
                                             height="22"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="#ff4d4d"
                                             stroke-width="3"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">

                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                            <line x1="6" y1="6" x2="18" y2="18"></line>

                                        </svg>

                                    </div>

                                {{/isExpired}}

                                <!-- 일반 -->
                                {{^isExpired}}

                                    <div class="check-wrapper"
                                         onclick="toggleTodo({{id}}, {{groupMember.group.id}})">
                                    </div>

                                {{/isExpired}}

                            {{/isDone}}

                        </td>

                        <!-- 유저 -->
                        <td style="width: 140px;">
                            <span class="user-badge">
                                @ {{groupMember.user.nickname}}
                            </span>
                        </td>

                        <!-- 할 일 -->
                        <td>
                            <span class="todo-text">
                                {{work}}
                            </span>
                        </td>

                        <!-- 날짜 -->
                        <td style="width: 160px;">

                            <div class="todo-date-wrapper">

                                <p class="date-label">Deadline</p>

                                <span class="todo-date-text {{#isExpired}}overdue-text{{/isExpired}}">
                                    {{formatDeadline}}
                                </span>

                            </div>

                        </td>

                        <!-- 상태 -->
                        <td style="width: 220px; text-align: right;">

                            {{#isDone}}

                                <div class="penalty-badge complete-badge">

                                    <span class="fine-label">
                                        STATUS
                                    </span>

                                    <span class="fine-val complete-text">
                                        COMPLETE
                                    </span>

                                </div>

                            {{/isDone}}

                            {{^isDone}}

                                {{#fine.hasAmount}}

                                    <div class="penalty-badge">

                                        <span class="fine-label">
                                            PAYMENT DUE
                                        </span>

                                        <span class="fine-val">
                                            ₩{{fine.amount}}
                                        </span>

                                    </div>

                                {{/fine.hasAmount}}

                                {{^fine.hasAmount}}

                                    {{^isExpired}}

                                        <div class="penalty-badge free">

                                            <span class="fine-label free-label">
                                                STATUS
                                            </span>

                                            <span class="fine-val free-text">
                                                NOT PENALTY FREE
                                            </span>

                                        </div>

                                    {{/isExpired}}

                                {{/fine.hasAmount}}

                            {{/isDone}}

                        </td>

                        <!-- 버튼 -->
                        <td style="width: 220px; text-align: right;">

                            <div style="display: flex; justify-content: flex-end; gap: 10px;">

                                <!-- 수정 -->
                                <a href="/todo/{{id}}/edit?groupId={{groupMember.group.id}}"
                                class="btn-todo-action btn-todo-edit">

                                수정

                                </a>

                                <!-- 삭제 -->
                                <form action="/todo/{{id}}/delete"
                                      method="post"
                                      onsubmit="return confirm('미션을 삭제할까요?');">

                                    <input type="hidden"
                                           name="groupId"
                                           value="{{groupMember.group.id}}">

                                    <button type="submit"
                                            class="btn-todo-action btn-todo-delete">

                                        삭제

                                    </button>

                                </form>

                            </div>

                        </td>

                    </tr>

                {{/todoList}}

                </tbody>
            </table>

        </div>

    </div>
</main>

<script>
    function toggleTodo(todoId, groupId) {
        location.href = `/todo/${todoId}/toggle?groupId=${groupId}`;
    }
</script>

{{> layout/footer}}