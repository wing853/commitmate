{{> layout/header}}

<style>
    :root {
        --bg: #030303;
        --primary: #ffffff;
        --accent: #6366f1;
        --border: rgba(255, 255, 255, 0.08);
        --text-muted: #8a8a8a;
        --glass: rgba(255, 255, 255, 0.03);
        --input-bg: rgba(255, 255, 255, 0.05);
    }

    /* 배경 효과 및 레이아웃 */
    .spotlight {
        position: fixed; top: -10%; left: 50%; transform: translateX(-50%);
        width: 100vw; height: 100vh;
        background: radial-gradient(circle at center, rgba(99, 102, 241, 0.1) 0%, transparent 70%);
        z-index: -1; pointer-events: none;
    }

    .save-form-container { padding: 60px 0; flex: 1; display: flex; align-items: center; }

    .form-container {
        width: 100%; background: var(--glass); border: 1px solid var(--border);
        border-radius: 28px; padding: 40px; backdrop-filter: blur(20px);
        max-width: 600px; margin: 0 auto;
    }

    .form-header { margin-bottom: 32px; }
    .form-header h1 { font-size: 28px; font-weight: 800; margin-bottom: 8px; letter-spacing: -1px; }
    .form-header p { color: var(--text-muted); font-size: 15px; }

    /* 입력 필드 스타일 */
    .form-group { margin-bottom: 24px; }
    .form-group label { display: block; font-size: 13px; font-weight: 700; color: var(--text-muted); margin-bottom: 8px; text-transform: uppercase; }

    .form-control {
        width: 100%; background: var(--input-bg); border: 1px solid var(--border);
        border-radius: 14px; padding: 14px 18px; color: #fff; font-size: 15px;
        transition: all 0.3s ease; outline: none;
    }
    .form-control:focus { border-color: var(--accent); background: rgba(99, 102, 241, 0.05); box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1); }

    /* 날짜 선택 아이콘 스타일 커스텀 */
    .form-control::-webkit-calendar-picker-indicator {
        filter: invert(1);
        cursor: pointer;
        opacity: 0.6;
    }
    .form-control::-webkit-calendar-picker-indicator:hover { opacity: 1; }

    /* 숫자 조절 버튼 숨기기 */
    .form-control::-webkit-outer-spin-button,
    .form-control::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    .form-control[type=number] { -moz-appearance: textfield; }

    /* 읽기 전용 정보 박스 */
    .info-display {
        background: rgba(255, 255, 255, 0.02);
        border: 1px dashed var(--border);
        padding: 14px 18px;
        border-radius: 14px;
        color: var(--accent);
        font-weight: 600;
        font-size: 15px;
    }

    /* 버튼 그룹 */
    .btn-group { display: grid; grid-template-columns: 1fr 2fr; gap: 12px; margin-top: 40px; }
    .btn {
        padding: 16px; border-radius: 14px; font-size: 15px; font-weight: 700;
        cursor: pointer; transition: all 0.3s ease; text-align: center; text-decoration: none; border: none;
    }
    .btn-cancel { background: transparent; color: var(--text-muted); border: 1px solid var(--border); }
    .btn-cancel:hover { background: rgba(255, 255, 255, 0.05); color: #fff; }

    .btn-submit { background: var(--accent); color: #fff; box-shadow: 0 8px 20px rgba(99, 102, 241, 0.3); }
    .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 12px 24px rgba(99, 102, 241, 0.4); filter: brightness(1.1); }
</style>

<div class="spotlight"></div>

<main class="save-form-container">
    <div class="container">
        <div class="form-container">
            <div class="form-header">
                <h1>🎯 New Mission</h1>
                <p>워크스페이스에 기록할 오늘의 목표를 입력하세요.</p>
            </div>

            <form action="/groups/{{groupId}}/todo/save" method="post">

                <!-- 할 일 내용 입력 -->
                <div class="form-group">
                    <label for="work">할 일 내용</label>
                    <input type="text" id="work" name="work" class="form-control"
                           placeholder="예: Spring Boot JPA 강의 3강 듣기" required autofocus>
                </div>

                <!-- 수행자 정보 -->
                <div class="form-group">
                    <label>수행자</label>
                    <div class="info-display">
                        @ {{sessionUser.nickname}}
                    </div>
                </div>

                <!-- 마감 기한 설정 필드 -->
                <div class="form-group">
                    <label for="deadline">마감 기한</label>
                    <input type="datetime-local" id="deadline" name="deadline" class="form-control" required>
                    <p style="color: var(--text-muted); font-size: 11px; margin-top: 10px;">
                        * 설정한 시간이 지나면 미달성 시 벌금이 부과될 수 있습니다.
                    </p>
                </div>

                <!-- 커스텀 벌금 입력 필드 -->
                <div class="form-group">
                    <label for="amount">미달성 시 벌금 (원)</label>
                    <input type="number" id="amount" name="amount" class="form-control"
                           placeholder="숫자만 입력 (예: 5000)" min="0" step="100">
                    <p style="color: var(--text-muted); font-size: 11px; margin-top: 10px;">
                        * 미션 미달성 시 부과될 금액입니다.
                    </p>
                </div>

                <!-- 데이터 전송을 위한 Hidden 필드 -->
                <input type="hidden" name="groupId" value="{{groupId}}">
                <input type="hidden" name="userId" value="{{sessionUser.id}}">

                <div class="btn-group">
                    <a href="/groups/{{groupId}}" class="btn btn-cancel">취소</a>
                    <button type="submit" class="btn btn-submit">미션 추가하기</button>
                </div>
            </form>
        </div>
    </div>
</main>

{{> layout/footer}}