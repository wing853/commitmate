{{> layout/header}}

<style>
    .update-container {
        padding: 60px 0;
        min-height: calc(100vh - 70px);
        background-color: var(--bg);
    }

    .update-card {
        background: #0a0a0a;
        border: 1px solid var(--border);
        border-radius: 28px;
        padding: 40px;
        box-shadow: 0 40px 80px rgba(0,0,0,0.5);
        max-width: 600px;
        margin: 0 auto;
    }

    .form-group { margin-bottom: 25px; }
    .form-label {
        display: block;
        color: var(--text-muted);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 10px;
        text-transform: uppercase;
    }

    .form-control {
        width: 100%;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 15px;
        color: #fff;
        font-size: 16px;
        transition: 0.3s;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--accent);
        background: rgba(255, 255, 255, 0.08);
    }

    .btn-group {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 15px;
        margin-top: 40px;
    }

    .btn-cancel {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text-muted);
        padding: 15px;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
    }

    .btn-submit {
        background: var(--accent);
        color: #fff;
        border: none;
        padding: 15px;
        border-radius: 12px;
        font-weight: 800;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-submit:hover { filter: brightness(1.2); transform: translateY(-2px); }

    .info-text {
        font-size: 12px;
        color: var(--text-muted);
        margin-top: 8px;
    }
</style>

<div class="update-container">
    <div class="container">
        <div class="update-card">
            <div style="margin-bottom: 30px;">
                <p style="color: var(--accent); font-weight: 800; margin-bottom: 5px;">EDIT MISSION</p>
                <h1 style="font-size: 28px;">미션 수정하기</h1>
            </div>

            <form action="/todos/{{todoId}}/update-form" method="post">
                <div class="form-group">
                    <label class="form-label">일정명 (Work)</label>
                    <input type="text" name="work" class="form-control" value="{{todo.work}}" required>
                </div>

                <div class="form-group">
                    <label class="form-label">마감 기한 (Deadline)</label>
                    <input type="datetime-local" name="deadline" class="form-control" value="{{todo.getDeadlineForInput}}" required>
                    <p class="info-text">현재 설정된 시간: {{todo.getFormatDeadline}}</p>
                </div>

                <div class="form-group">
                    <label class="form-label">미이행 벌금 (Penalty Amount)</label>
                    <div style="position: relative;">
                        <span style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: var(--text-muted);">₩</span>
                        <input type="number" name="amount" class="form-control" style="padding-left: 35px;" value="{{#todo.fine}}{{amount}}{{/todo.fine}}{{^todo.fine}}0{{/todo.fine}}" placeholder="0">
                    </div>
                    <p class="info-text">미션 실패 시 부과될 벌금을 입력해 주세요.</p>
                </div>

                <div class="btn-group">
                    <a href="/groups/{{groupId}}/todos" class="btn-cancel">취소</a>
                    <button type="submit" class="btn-submit">수정 완료</button>
                </div>
            </form>
        </div>
    </div>
</div>

{{> layout/footer}}