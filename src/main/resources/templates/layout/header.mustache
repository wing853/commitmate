<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CommitMate</title>
    <style>
        :root {
            --bg: #030303;
            --primary: #ffffff;
            --accent: #6366f1;
            --danger: #ff4d4d;
            --border: rgba(255, 255, 255, 0.08);
            --text-muted: #8a8a8a;
            --glass: rgba(255, 255, 255, 0.03);
            --success: #4ade80;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Pretendard', sans-serif; }
        body { background-color: var(--bg); color: #fff; overflow-x: hidden; letter-spacing: -0.5px; min-height: 100vh; }

        .spotlight {
            position: fixed; top: -10%; left: 50%; transform: translateX(-50%);
            width: 100vw; height: 100vh;
            background: radial-gradient(circle at center, rgba(99, 102, 241, 0.08) 0%, transparent 70%);
            z-index: -1; pointer-events: none;
        }

        header {
            height: 70px; display: flex; align-items: center; border-bottom: 1px solid var(--border);
            position: sticky; top: 0; background: rgba(3, 3, 3, 0.8); backdrop-filter: blur(15px); z-index: 100;
        }
        .container { max-width: 1100px; margin: 0 auto; padding: 0 24px; width: 100%; }
        .header-inner { display: flex; justify-content: space-between; align-items: center; }
        .logo { font-size: 20px; font-weight: 800; letter-spacing: -1px; text-decoration: none; color: #fff; }

        .user-profile { display: flex; align-items: center; gap: 12px; }
        .avatar {
            width: 32px; height: 32px; background: var(--glass); border: 1px solid var(--border);
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            font-size: 13px; font-weight: 700; color: var(--accent); overflow: hidden;
        }

        .btn-logout {
            padding: 6px 14px; font-size: 12px; font-weight: 700; color: var(--text-muted);
            text-decoration: none; border: 1px solid var(--border); border-radius: 10px;
            transition: all 0.3s ease; background: transparent;
        }
        .btn-logout:hover {
            color: var(--danger); border-color: rgba(255, 77, 77, 0.3);
            background: rgba(255, 77, 77, 0.05); transform: translateY(-1px);
        }
        /* 공통 카드 및 그리드 스타일은 그대로 유지하거나 여기에 포함 */
        .workspace-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; }
        .card {
            background: var(--glass); border: 1px solid var(--border); border-radius: 24px; padding: 32px;
            transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1); position: relative;
            display: flex; flex-direction: column; cursor: pointer; backdrop-filter: blur(10px);
            text-decoration: none; color: inherit;
        }
        .card:hover { transform: translateY(-8px); border-color: var(--accent); background: rgba(99, 102, 241, 0.02); }
        .badge { display: inline-block; padding: 5px 12px; border-radius: 8px; font-size: 11px; font-weight: 800; margin-bottom: 20px; width: fit-content; text-transform: uppercase; }
        .badge.admin { background: rgba(99, 102, 241, 0.15); color: var(--accent); border: 1px solid rgba(99, 102, 241, 0.2); }
        .badge.member { background: rgba(255, 255, 255, 0.05); color: var(--text-muted); border: 1px solid var(--border); }
        .btn-admin-edit {
            margin-top: 16px; width: 100%; padding: 10px; background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border); border-radius: 12px; color: #fff; font-size: 13px;
            font-weight: 600; text-align: center; text-decoration: none; transition: 0.2s;
            display: flex; align-items: center; justify-content: center; gap: 6px;
        }
        .btn-admin-edit:hover { background: var(--accent); border-color: var(--accent); color: white; }
    </style>
</head>
<body>
<div class="spotlight"></div>
<header>
    <div class="container header-inner">
        <a href="/groups" class="logo">CommitMate.</a>
        <div class="user-profile">
            {{#sessionUser}}
                <span style="font-size: 14px; font-weight: 600; color: var(--text-muted);">{{nickname}} 님</span>
                <div class="avatar">{{nickname}}</div>
                <a href="/logout" class="btn-logout">로그아웃</a>
            {{/sessionUser}}
        </div>
    </div>
</header>