<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CommitMate</title>
    <style>
        :root {
            --bg: #0e0f11;
            --danger: #f87171;
            --border: rgba(255,255,255,0.06);
            --text-muted: #555;
            --glass: rgba(255,255,255,0.02);
            --green: #34d399;
            --warning: #f59e0b;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Pretendard', sans-serif; }
        body { background-color: var(--bg); color: #fff; overflow-x: hidden; letter-spacing: -0.3px; min-height: 100vh; }

        header {
            height: 64px; display: flex; align-items: center;
            border-bottom: 0.5px solid var(--border);
            position: sticky; top: 0;
            background: rgba(14,15,17,0.85);
            backdrop-filter: blur(20px); z-index: 100;
        }

        .container { max-width: 1100px; margin: 0 auto; padding: 0 24px; width: 100%; }
        .header-inner { display: flex; justify-content: space-between; align-items: center; }

        .logo {
            font-size: 18px; font-weight: 700; letter-spacing: -0.5px;
            text-decoration: none; color: #fff;
        }
        .logo span { color: var(--danger); }

        .user-profile { display: flex; align-items: center; gap: 10px; }

        .user-name { font-size: 13px; font-weight: 500; color: var(--text-muted); }

        .avatar {
            width: 30px; height: 30px;
            background: #1a1010;
            border: 0.5px solid rgba(248,113,113,0.25);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 11px; font-weight: 700; color: var(--danger);
            overflow: hidden;
        }

        .btn-logout {
            padding: 6px 14px; font-size: 12px; font-weight: 600;
            color: var(--text-muted);
            text-decoration: none;
            border: 0.5px solid rgba(255,255,255,0.06);
            border-radius: 8px;
            transition: 0.2s; background: transparent;
        }
        .btn-logout:hover {
            color: var(--danger);
            border-color: rgba(248,113,113,0.25);
            background: rgba(248,113,113,0.05);
        }

        /* 공통 카드/그리드 */
        .workspace-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 16px;
        }

        .card {
            background: #111214;
            border: 0.5px solid rgba(255,255,255,0.08);
            border-radius: 16px; padding: 28px;
            transition: all 0.2s ease;
            position: relative; display: flex; flex-direction: column;
            cursor: pointer; text-decoration: none; color: inherit;
        }
        .card:hover {
            transform: translateY(-4px);
            border-color: rgba(248,113,113,0.3);
            background: #131416;
        }

        .badge {
            display: inline-block; padding: 4px 10px;
            border-radius: 6px; font-size: 10px; font-weight: 700;
            margin-bottom: 16px; width: fit-content;
            text-transform: uppercase; letter-spacing: 1px;
        }
        .badge.admin {
            background: rgba(248,113,113,0.1);
            color: var(--danger);
            border: 0.5px solid rgba(248,113,113,0.2);
        }
        .badge.member {
            background: rgba(255,255,255,0.03);
            color: var(--text-muted);
            border: 0.5px solid rgba(255,255,255,0.06);
        }

        .btn-admin-edit {
            margin-top: 16px; width: 100%; padding: 9px;
            background: rgba(255,255,255,0.03);
            border: 0.5px solid rgba(255,255,255,0.08);
            border-radius: 10px; color: #555; font-size: 12px;
            font-weight: 600; text-align: center; text-decoration: none;
            transition: 0.2s; display: flex; align-items: center;
            justify-content: center; gap: 6px;
        }
        .btn-admin-edit:hover {
            background: rgba(248,113,113,0.08);
            border-color: rgba(248,113,113,0.25);
            color: var(--danger);
        }
    </style>
</head>
<body>
<header>
    <div class="container header-inner">
        <a href="/groups" class="logo">Commit<span>Mate</span>.</a>
        <div class="user-profile">
            {{#sessionUser}}
                <span class="user-name">{{nickname}} 님</span>
                <div class="avatar">{{nickname}}</div>
                <a href="/logout" class="btn-logout">로그아웃</a>
            {{/sessionUser}}
        </div>
    </div>
</header>